@@ -29,6 +34,395 @@ fn destroy_boxed_slice(ptr: c_slice::Box<u8>) {
 // A byte serialized representation of a vanilla proof.
 pub type ApiVanillaProof = Vec<u8>;
 
+const ZIGZAG_DEVNET_ENV: &str = "FIL_PROOFS_USE_ZIGZAG";
+const ZIGZAG_PARAMETER_CACHE_ENV: &str = "FIL_PROOFS_PARAMETER_CACHE";
+const ZIGZAG_ENVELOPE_KIND: &str = "filecoin-ffi-zigzag-devnet";
+const ZIGZAG_ENVELOPE_VERSION: u8 = 1;
+const ZIGZAG_SNARK_PROOF_BYTES: usize = 192;
+const ZIGZAG_2_KIB: u64 = 2 * 1024;
+const ZIGZAG_8_MIB: u64 = 8 * 1024 * 1024;
+const ZIGZAG_CURIO_TREE_D_FILE: &str = "sc-02-data-tree-d.dat";
+const ZIGZAG_CURIO_REPLICA_ID_FILE: &str = "zigzag-replica-id.json";
+const ZIGZAG_PROOF_SIDECAR_DIR: &str = "zigzag-proof-sidecars";
+
+#[derive(Debug, Serialize, Deserialize)]
+struct ZigZagPreCommitPhase1Envelope {
+    zigzag: String,
+    version: u8,
+    registered_proof: i32,
+    comm_d: [u8; 32],
+    comm_r: [u8; 32],
+    comm_r_star: [u8; 32],
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+struct ZigZagProofEnvelope {
+    zigzag: String,
+    version: u8,
+    comm_r: [u8; 32],
+    comm_r_star: [u8; 32],
+    proof_hex: String,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+struct ZigZagProofSidecar {
+    zigzag: String,
+    version: u8,
+    registered_proof: i32,
+    sector_id: u64,
+    comm_d: [u8; 32],
+    bound_comm_r: [u8; 32],
+    comm_r: [u8; 32],
+    comm_r_star: [u8; 32],
+    prover_id: [u8; 32],
+    ticket: [u8; 32],
+    seed: [u8; 32],
+    proof_len: usize,
+    proof_prefix_hex: String,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+struct ZigZagReplicaIdManifest {
+    zigzag: String,
+    version: u8,
+    replica_id: [u8; 32],
+}
+
+#[derive(Debug, Deserialize)]
+struct CurioSplitPreCommitPhase1Output {
+    comm_d: [u8; 32],
+    registered_proof: String,
+}
+
+fn zigzag_devnet_enabled() -> bool {
+    std::env::var(ZIGZAG_DEVNET_ENV)
+        .map(|value| {
+            matches!(
+                value.to_ascii_lowercase().as_str(),
+                "1" | "true" | "yes" | "on"
+            )
+        })
+        .unwrap_or(false)
+}
+
+fn zigzag_registered_sector_size(registered_proof: RegisteredSealProof) -> u64 {
+    let registered_proof: api::RegisteredSealProof = registered_proof.into();
+    registered_proof.sector_size().into()
+}
+
+fn zigzag_registered_porep_id(registered_proof: RegisteredSealProof) -> [u8; 32] {
+    let registered_proof: api::RegisteredSealProof = registered_proof.into();
+    registered_proof.as_v1_config().porep_id
+}
+
+fn zigzag_supported_sector_size(sector_size: u64) -> bool {
+    matches!(sector_size, ZIGZAG_2_KIB | ZIGZAG_8_MIB)
+}
+
+fn zigzag_devnet_proof(registered_proof: RegisteredSealProof) -> bool {
+    zigzag_devnet_enabled()
+        && zigzag_supported_sector_size(zigzag_registered_sector_size(registered_proof))
+}
+
+fn zigzag_porep_config(registered_proof: RegisteredSealProof) -> Result<zigzag::PoRepConfig> {
+    let sector_size = zigzag_registered_sector_size(registered_proof);
+    ensure!(
+        zigzag_supported_sector_size(sector_size),
+        "ZigZag devnet FFI only supports 2KiB and 8MiB sectors, got {} bytes for {:?}",
+        sector_size,
+        registered_proof
+    );
+
+    Ok(zigzag::PoRepConfig::new_groth16(
+        sector_size,
+        zigzag_registered_porep_id(registered_proof),
+        zigzag_core::api_version::ApiVersion::V1_2_0,
+    ))
+}
+
+fn zigzag_sector_id(sector_id: u64) -> zigzag_core::sector::SectorId {
+    zigzag_core::sector::SectorId::from(sector_id)
+}
+
+fn zigzag_piece_infos(pieces: &[PieceInfo]) -> Vec<zigzag::PieceInfo> {
+    pieces
+        .iter()
+        .map(|piece| zigzag::PieceInfo {
+            commitment: piece.commitment,
+            size: zigzag::UnpaddedBytesAmount(u64::from(piece.size)),
+        })
+        .collect()
+}
+
+fn registered_seal_proof_as_i32(registered_proof: RegisteredSealProof) -> i32 {
+    registered_proof as i32
+}
+
+fn registered_seal_proof_from_i32(value: i32) -> Result<RegisteredSealProof> {
+    use RegisteredSealProof::*;
+    Ok(match value {
+        0 => StackedDrg2KiBV1,
+        1 => StackedDrg8MiBV1,
+        2 => StackedDrg512MiBV1,
+        3 => StackedDrg32GiBV1,
+        4 => StackedDrg64GiBV1,
+        5 => StackedDrg2KiBV1_1,
+        6 => StackedDrg8MiBV1_1,
+        7 => StackedDrg512MiBV1_1,
+        8 => StackedDrg32GiBV1_1,
+        9 => StackedDrg64GiBV1_1,
+        10 => StackedDrg2KiBV1_1_Feat_SyntheticPoRep,
+        11 => StackedDrg8MiBV1_1_Feat_SyntheticPoRep,
+        12 => StackedDrg512MiBV1_1_Feat_SyntheticPoRep,
+        13 => StackedDrg32GiBV1_1_Feat_SyntheticPoRep,
+        14 => StackedDrg64GiBV1_1_Feat_SyntheticPoRep,
+        15 => StackedDrg2KiBV1_2_Feat_NonInteractivePoRep,
+        16 => StackedDrg8MiBV1_2_Feat_NonInteractivePoRep,
+        17 => StackedDrg512MiBV1_2_Feat_NonInteractivePoRep,
+        18 => StackedDrg32GiBV1_2_Feat_NonInteractivePoRep,
+        19 => StackedDrg64GiBV1_2_Feat_NonInteractivePoRep,
+        _ => bail!("unknown registered seal proof discriminant: {}", value),
+    })
+}
+
+fn registered_seal_proof_from_curio_name(value: &str) -> Option<RegisteredSealProof> {
+    use RegisteredSealProof::*;
+    match value {
+        "StackedDrg2KiBV1" => Some(StackedDrg2KiBV1),
+        "StackedDrg8MiBV1" => Some(StackedDrg8MiBV1),
+        "StackedDrg2KiBV1_1" => Some(StackedDrg2KiBV1_1),
+        "StackedDrg8MiBV1_1" => Some(StackedDrg8MiBV1_1),
+        "StackedDrg2KiBV1_1_Feat_SyntheticPoRep" => Some(StackedDrg2KiBV1_1_Feat_SyntheticPoRep),
+        "StackedDrg8MiBV1_1_Feat_SyntheticPoRep" => Some(StackedDrg8MiBV1_1_Feat_SyntheticPoRep),
+        _ => None,
+    }
+}
+
+fn parse_zigzag_pre_commit_phase1(bytes: &[u8]) -> Result<Option<ZigZagPreCommitPhase1Envelope>> {
+    let Ok(output) = serde_json::from_slice::<ZigZagPreCommitPhase1Envelope>(bytes) else {
+        return Ok(None);
+    };
+
+    if output.zigzag != ZIGZAG_ENVELOPE_KIND {
+        return Ok(None);
+    }
+
+    ensure!(
+        output.version == ZIGZAG_ENVELOPE_VERSION,
+        "unsupported ZigZag pre-commit envelope version: {}",
+        output.version
+    );
+    Ok(Some(output))
+}
+
+fn parse_curio_split_pre_commit_phase1(
+    bytes: &[u8],
+) -> Result<Option<(RegisteredSealProof, [u8; 32])>> {
+    let Ok(output) = serde_json::from_slice::<CurioSplitPreCommitPhase1Output>(bytes) else {
+        return Ok(None);
+    };
+    let Some(registered_proof) = registered_seal_proof_from_curio_name(&output.registered_proof)
+    else {
+        return Ok(None);
+    };
+
+    Ok(Some((registered_proof, output.comm_d)))
+}
+
+fn write_zigzag_replica_id_manifest(
+    output_dir: &std::path::Path,
+    replica_id: [u8; 32],
+) -> Result<()> {
+    let manifest = ZigZagReplicaIdManifest {
+        zigzag: ZIGZAG_ENVELOPE_KIND.to_string(),
+        version: ZIGZAG_ENVELOPE_VERSION,
+        replica_id,
+    };
+    let bytes = serde_json::to_vec_pretty(&manifest).context("serialize ZigZag replica ID")?;
+    fs::write(output_dir.join(ZIGZAG_CURIO_REPLICA_ID_FILE), bytes)
+        .context("write ZigZag replica ID manifest")
+}
+
+fn read_zigzag_replica_id_manifest(cache_dir: &std::path::Path) -> Result<[u8; 32]> {
+    let path = cache_dir.join(ZIGZAG_CURIO_REPLICA_ID_FILE);
+    let bytes = fs::read(&path).with_context(|| format!("read ZigZag replica ID at {:?}", path))?;
+    let manifest: ZigZagReplicaIdManifest =
+        serde_json::from_slice(&bytes).context("deserialize ZigZag replica ID")?;
+    ensure!(
+        manifest.zigzag == ZIGZAG_ENVELOPE_KIND,
+        "unexpected ZigZag replica ID manifest kind: {}",
+        manifest.zigzag
+    );
+    ensure!(
+        manifest.version == ZIGZAG_ENVELOPE_VERSION,
+        "unsupported ZigZag replica ID manifest version: {}",
+        manifest.version
+    );
+    Ok(manifest.replica_id)
+}
+
+fn read_curio_tree_d_sector(cache_dir: &std::path::Path, sector_size: u64) -> Result<Vec<u8>> {
+    let tree_d_path = cache_dir.join(ZIGZAG_CURIO_TREE_D_FILE);
+    let sector_size = usize::try_from(sector_size).context("sector size does not fit usize")?;
+    let mut data = vec![0u8; sector_size];
+    let mut file = fs::File::open(&tree_d_path)
+        .with_context(|| format!("open Curio TreeD file at {:?}", tree_d_path))?;
+    file.read_exact(&mut data)
+        .with_context(|| format!("read sector data prefix from {:?}", tree_d_path))?;
+    Ok(data)
+}
+
+fn encode_zigzag_proof_envelope(
+    comm_r: [u8; 32],
+    comm_r_star: [u8; 32],
+    proof: &[u8],
+) -> Result<Vec<u8>> {
+    serde_json::to_vec(&ZigZagProofEnvelope {
+        zigzag: ZIGZAG_ENVELOPE_KIND.to_string(),
+        version: ZIGZAG_ENVELOPE_VERSION,
+        comm_r,
+        comm_r_star,
+        proof_hex: hex::encode(proof),
+    })
+    .context("serialize ZigZag proof envelope")
+}
+
+fn parse_zigzag_proof_envelope(bytes: &[u8]) -> Result<Option<(ZigZagProofEnvelope, Vec<u8>)>> {
+    let Ok(envelope) = serde_json::from_slice::<ZigZagProofEnvelope>(bytes) else {
+        return Ok(None);
+    };
+
+    if envelope.zigzag != ZIGZAG_ENVELOPE_KIND {
+        return Ok(None);
+    }
+
+    ensure!(
+        envelope.version == ZIGZAG_ENVELOPE_VERSION,
+        "unsupported ZigZag proof envelope version: {}",
+        envelope.version
+    );
+    let proof = hex::decode(&envelope.proof_hex).context("decode ZigZag proof bytes")?;
+    Ok(Some((envelope, proof)))
+}
+
+fn zigzag_parameter_cache_dir() -> std::path::PathBuf {
+    std::env::var(ZIGZAG_PARAMETER_CACHE_ENV)
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|_| std::path::PathBuf::from("/var/tmp/filecoin-proof-parameters"))
+}
+
+fn zigzag_proof_prefix_hex(proof: &[u8]) -> String {
+    let prefix_len = proof.len().min(16);
+    hex::encode(&proof[..prefix_len])
+}
+
+fn zigzag_proof_sidecar_path(
+    registered_proof: RegisteredSealProof,
+    sector_id: u64,
+    bound_comm_r: &[u8; 32],
+    comm_d: &[u8; 32],
+    proof: &[u8],
+) -> std::path::PathBuf {
+    zigzag_parameter_cache_dir()
+        .join(ZIGZAG_PROOF_SIDECAR_DIR)
+        .join(format!(
+            "v{}-rp{}-s{}-cr{}-cd{}-p{}.json",
+            ZIGZAG_ENVELOPE_VERSION,
+            registered_seal_proof_as_i32(registered_proof),
+            sector_id,
+            hex::encode(&bound_comm_r[..8]),
+            hex::encode(&comm_d[..8]),
+            zigzag_proof_prefix_hex(proof)
+        ))
+}
+
+#[allow(clippy::too_many_arguments)]
+fn write_zigzag_proof_sidecar(
+    registered_proof: RegisteredSealProof,
+    sector_id: u64,
+    comm_d: [u8; 32],
+    bound_comm_r: [u8; 32],
+    comm_r: [u8; 32],
+    comm_r_star: [u8; 32],
+    prover_id: [u8; 32],
+    ticket: [u8; 32],
+    seed: [u8; 32],
+    proof: &[u8],
+) -> Result<()> {
+    ensure!(
+        proof.len() == ZIGZAG_SNARK_PROOF_BYTES,
+        "ZigZag devnet raw proof length must be {} bytes, got {}",
+        ZIGZAG_SNARK_PROOF_BYTES,
+        proof.len()
+    );
+    let sidecar = ZigZagProofSidecar {
+        zigzag: ZIGZAG_ENVELOPE_KIND.to_string(),
+        version: ZIGZAG_ENVELOPE_VERSION,
+        registered_proof: registered_seal_proof_as_i32(registered_proof),
+        sector_id,
+        comm_d,
+        bound_comm_r,
+        comm_r,
+        comm_r_star,
+        prover_id,
+        ticket,
+        seed,
+        proof_len: proof.len(),
+        proof_prefix_hex: zigzag_proof_prefix_hex(proof),
+    };
+    let path = zigzag_proof_sidecar_path(registered_proof, sector_id, &bound_comm_r, &comm_d, proof);
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).context("create ZigZag proof sidecar directory")?;
+    }
+    fs::write(&path, serde_json::to_vec_pretty(&sidecar)?)
+        .with_context(|| format!("write ZigZag proof sidecar at {:?}", path))
+}
+
+#[allow(clippy::too_many_arguments)]
+fn read_zigzag_proof_sidecar(
+    registered_proof: RegisteredSealProof,
+    sector_id: u64,
+    comm_d: [u8; 32],
+    bound_comm_r: [u8; 32],
+    prover_id: [u8; 32],
+    ticket: [u8; 32],
+    seed: [u8; 32],
+    proof: &[u8],
+) -> Result<ZigZagProofSidecar> {
+    let path = zigzag_proof_sidecar_path(registered_proof, sector_id, &bound_comm_r, &comm_d, proof);
+    let bytes = fs::read(&path)
+        .with_context(|| format!("read ZigZag proof sidecar at {:?}", path))?;
+    let sidecar: ZigZagProofSidecar =
+        serde_json::from_slice(&bytes).context("deserialize ZigZag proof sidecar")?;
+
+    ensure!(sidecar.zigzag == ZIGZAG_ENVELOPE_KIND, "unexpected ZigZag sidecar kind");
+    ensure!(sidecar.version == ZIGZAG_ENVELOPE_VERSION, "unsupported ZigZag sidecar version");
+    ensure!(
+        sidecar.registered_proof == registered_seal_proof_as_i32(registered_proof),
+        "ZigZag sidecar registered proof mismatch"
+    );
+    ensure!(sidecar.sector_id == sector_id, "ZigZag sidecar sector id mismatch");
+    ensure!(sidecar.comm_d == comm_d, "ZigZag sidecar comm_d mismatch");
+    ensure!(
+        sidecar.bound_comm_r == bound_comm_r,
+        "ZigZag sidecar bound comm_r mismatch"
+    );
+    ensure!(
+        zigzag::zigzag_comm_r_bound(&sidecar.comm_r, &sidecar.comm_r_star) == bound_comm_r,
+        "ZigZag sidecar commitments do not bind to comm_r"
+    );
+    ensure!(sidecar.prover_id == prover_id, "ZigZag sidecar prover id mismatch");
