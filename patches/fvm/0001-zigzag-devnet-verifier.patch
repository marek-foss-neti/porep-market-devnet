+fn zigzag_api_registered_seal_proof(
+    registered_proof: RegisteredSealProof,
+) -> Result<proofs::RegisteredSealProof> {
+    registered_proof
+        .try_into()
+        .or_illegal_argument()
+        .context(format_args!("invalid proof type {:?}", registered_proof))
+}
+
+fn zigzag_devnet_proof(registered_proof: RegisteredSealProof) -> Result<bool> {
+    if !zigzag_devnet_enabled() {
+        return Ok(false);
+    }
+
+    let registered_proof = zigzag_api_registered_seal_proof(registered_proof)?;
+    Ok(zigzag_supported_sector_size(u64::from(
+        registered_proof.sector_size(),
+    )))
+}
+
+fn zigzag_porep_config(
+    registered_proof: proofs::RegisteredSealProof,
+) -> Result<zigzag_proofs::PoRepConfig> {
+    let sector_size = u64::from(registered_proof.sector_size());
+    if !zigzag_supported_sector_size(sector_size) {
+        return Err(syscall_error!(
+            IllegalArgument;
+            "ZigZag devnet FVM verifier only supports 2KiB and 8MiB sectors, got {} bytes",
+            sector_size
+        )
+        .into());
+    }
+
+    Ok(zigzag_proofs::PoRepConfig::new_groth16(
+        sector_size,
+        registered_proof.as_v1_config().porep_id,
+        proofs::ApiVersion::V1_2_0,
+    ))
+}
+
+fn zigzag_parameter_cache_dir() -> std::path::PathBuf {
+    std::env::var(ZIGZAG_PARAMETER_CACHE_ENV)
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|_| std::path::PathBuf::from("/var/tmp/filecoin-proof-parameters"))
+}
+
+fn zigzag_hex(bytes: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for &byte in bytes {
+        out.push(HEX[(byte >> 4) as usize] as char);
+        out.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    out
+}
+
+fn zigzag_proof_prefix_hex(proof: &[u8]) -> String {
+    let prefix_len = proof.len().min(16);
+    zigzag_hex(&proof[..prefix_len])
+}
+
+fn zigzag_proof_sidecar_path(
+    registered_proof: RegisteredSealProof,
+    sector_id: u64,
+    bound_comm_r: &[u8; 32],
+    comm_d: &[u8; 32],
+    proof: &[u8],
+) -> std::path::PathBuf {
+    zigzag_parameter_cache_dir()
+        .join(ZIGZAG_PROOF_SIDECAR_DIR)
+        .join(format!(
+            "v{}-rp{}-s{}-cr{}-cd{}-p{}.json",
+            ZIGZAG_ENVELOPE_VERSION,
+            i64::from(registered_proof),
+            sector_id,
+            zigzag_hex(&bound_comm_r[..8]),
+            zigzag_hex(&comm_d[..8]),
+            zigzag_proof_prefix_hex(proof)
+        ))
+}
+
+fn read_zigzag_proof_sidecar(
+    registered_proof: RegisteredSealProof,
+    sector_id: u64,
+    comm_d: [u8; 32],
+    bound_comm_r: [u8; 32],
+    prover_id: [u8; 32],
+    ticket: [u8; 32],
+    seed: [u8; 32],
+    proof: &[u8],
+) -> Result<ZigZagProofSidecar> {
+    let path = zigzag_proof_sidecar_path(registered_proof, sector_id, &bound_comm_r, &comm_d, proof);
+    let bytes = fs::read(&path)
+        .or_illegal_argument()
+        .context(format_args!("read ZigZag proof sidecar at {:?}", path))?;
+    let sidecar: ZigZagProofSidecar = serde_json::from_slice(&bytes)
+        .or_illegal_argument()
+        .context("deserialize ZigZag proof sidecar")?;
+
+    zigzag_ensure!(sidecar.zigzag == ZIGZAG_ENVELOPE_KIND, "unexpected ZigZag sidecar kind");
+    zigzag_ensure!(sidecar.version == ZIGZAG_ENVELOPE_VERSION, "unsupported ZigZag sidecar version");
+    zigzag_ensure!(
+        sidecar.registered_proof == i64::from(registered_proof) as i32,
+        "ZigZag sidecar registered proof mismatch"
+    );
+    zigzag_ensure!(sidecar.sector_id == sector_id, "ZigZag sidecar sector id mismatch");
+    zigzag_ensure!(sidecar.comm_d == comm_d, "ZigZag sidecar comm_d mismatch");
+    zigzag_ensure!(sidecar.bound_comm_r == bound_comm_r, "ZigZag sidecar bound comm_r mismatch");
+    zigzag_ensure!(
+        zigzag_proofs::zigzag_comm_r_bound(&sidecar.comm_r, &sidecar.comm_r_star)
+            == bound_comm_r,
+        "ZigZag sidecar commitments do not bind to comm_r"
+    );
+    zigzag_ensure!(sidecar.prover_id == prover_id, "ZigZag sidecar prover id mismatch");
+    zigzag_ensure!(sidecar.ticket == ticket, "ZigZag sidecar ticket mismatch");
+    zigzag_ensure!(sidecar.seed == seed, "ZigZag sidecar seed mismatch");
+    zigzag_ensure!(sidecar.proof_len == proof.len(), "ZigZag sidecar proof length mismatch");
+    zigzag_ensure!(proof.len() == ZIGZAG_SNARK_PROOF_BYTES, "ZigZag proof length mismatch");
+    zigzag_ensure!(
+        sidecar.proof_prefix_hex == zigzag_proof_prefix_hex(proof),
+        "ZigZag sidecar proof prefix mismatch"
+    );
+
+    Ok(sidecar)
+}
