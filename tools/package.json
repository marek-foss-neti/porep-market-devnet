{
  "name": "porep-market-devnet-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "test:measurements": "node --test ../scripts/test/proof-micro-measurements.test.mjs",
    "test:cpu-settings": "node --test ../scripts/test/zigzag-cpu-settings.test.mjs",
    "test:gpu-settings": "node --test ../scripts/test/zigzag-gpu-settings.test.mjs && PYTHONDONTWRITEBYTECODE=1 python3 ../scripts/test/zigzag-gpu-trace.test.py",
    "test:build-resources": "node --test ../scripts/test/build-resources.test.mjs",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
